# PM Bridge — Environment Variables
# Copy to .env for local dev, or set in Sliplane dashboard for production

# REQUIRED: ElevenLabs API key for WebSocket connections to agents
ELEVENLABS_API_KEY=sk_your_key_here

# REQUIRED: Twilio credentials (for sending responses)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Auth token for the /chat endpoint (prevents unauthorized access)
BRIDGE_AUTH_TOKEN=pm-bridge-secret-2026

# Port (Sliplane uses 3000 by default)
PORT=3000

# Sandbox config: default doctor for Twilio Sandbox testing
# (Sandbox shares one number for all doctors, so we hardcode a default)
SANDBOX_DOCTOR_ID=PM-TEST-001
SANDBOX_AGENT_ID=agent_7001kkf42e44f3ethezn15t0dh11

# Optional: n8n webhook URL for production doctor lookup by phone number
# MASTER_SHEET_LOOKUP_URL=https://n8n-promptmaestro.sliplane.app/webhook/doctor-lookup
